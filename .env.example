# PostgreSQL Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://username:password@localhost:5432/taskflow"

# NextAuth v4 Configuration
# Canonical URL of your deployment (http://localhost:3000 for local development)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-generated-32-byte-secret"

# Google Cloud OAuth 2.0 Credentials
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Gmail SMTP Email Notifications (Nodemailer)
# Gmail address sending the task notifications
GMAIL_USER="your-email@gmail.com"
# 16-character Google App Password (generated in Google Account > Security > 2-Step Verification > App Passwords)
GMAIL_APP_PASSWORD="your-16-character-app-password"

# ─── AI Features (TaskFlow AI) ─────────────────────────────────────────────────
# Google Gemini API Key — REQUIRED for all AI features
# Get yours at: https://aistudio.google.com/app/apikey
# IMPORTANT: Never commit this value. Keep it in .env only.
GEMINI_API_KEY="your-gemini-api-key"
